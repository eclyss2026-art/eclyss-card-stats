# Materiale di backup, prove e archivi storici — non fa parte del sito live
_archive/
migliore back up/

# Sorgenti HTML in chiaro (pre-StaticCrypt): si modificano qui, poi si ricifra
# con staticrypt nella root. MAI committare: online il sito e' protetto da
# password, questi file ne esporrebbero i contenuti in chiaro su GitHub.
_src/

# Originali a piena risoluzione delle carte (PNG da ~2,7 MB l'uno, 43 MB in
# tutto). Sul sito vanno le versioni WebP a 700px generate da questi, ~230 KB
# l'una. Gli originali restano solo in locale: servono per rigenerare, non per
# essere serviti. Qui dentro anche assets/Custodi/, non piu' referenziata.
_assets-originali/

# Environment variables (credenziali live - mai committare)
.env
.env.local
.env.*.local

# File di sistema
.DS_Store
Thumbs.db
desktop.ini
